---
interface CardExperienceProps {
  title: string;
  emp: string;
  description?: string;
  date: string;
}
const { title, emp, description, date } = Astro.props as CardExperienceProps;
---

<div class="flex flex-col items-start">
  <div class="flex flex-col gap-1">
    <p class="font-bold">{title}</p>
    <p class="text-sm font-bold text-primary-foreground">{emp}</p>
    {description && <p class="text-sm text-foreground-muted">{description}</p>}
  </div>

  <p class="text-sm text-foreground-muted text-center">{date}</p>
</div>
