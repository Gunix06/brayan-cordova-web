---
import { Image } from "astro:assets";

interface Props {
  title: string;
  description: string;
  image: ImageMetadata;
  link?: string;
}

const { title, description, image, link }: Props = Astro.props;
---

<a href={link} class="flex flex-col border rounded-2xl border-transparent [border-image:linear-gradient(0deg,#171717_0%,#0A0A0A00_100%)_1] overflow-clip">
  <Image src={image} alt={title} width={472} height={357} class="w-full object-cover" />
  <div class="flex p-4 flex-col gap-3">
    <h3>{title}</h3>
    <p class="text-sm text-foreground-muted">{description}</p>
  </div>
  <div class="flex p-2.5 gap-2.5 flex-wrap">
    <slot />
  </div>
</a>
