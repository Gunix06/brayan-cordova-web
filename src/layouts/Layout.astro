import Nav from "@/components/layout/Nav.astro";
import MetaTags from "@/components/layout/MetaTags.astro";
import "@fontsource-variable/jost";
import "@fontsource/kodchasan";
---

<!doctype html>
<html lang="es">
  <head>
    <MetaTags title={"Brayan Cordova | Desarrollador Web"} description={"Especializado en ecosistemas React, Astro y desarrollo en Java. Transformo ideas en interfaces optimizadas y ecosistemas escalables."} autor={"Brayan Cordova"} />
  </head>
  <body>
    <Nav />
    <main class="flex flex-col items-start grow mx-4 lg:mx-20 py-4 gap-8 2xl:mx-44 2xl:py-8 2xl:gap-16 transition">
      <slot />
    </main>
    <Footer />
